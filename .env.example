# AI-Powered Observability - Environment Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# LLM Provider Configuration (OpenAI Credits Primary)
# Default: GPT-5.6 Terra with high reasoning for grounded incident analysis.
# Change only these non-secret settings if you need a different model or effort.
OPENAI_API_KEY=sk-proj-...

LLM_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=high
# Cap paid LLM explanations per upload/sample ingest. Remaining incidents use
# the deterministic evidence-linked fallback.
LLM_MAX_INCIDENTS_PER_INGESTION=3

# Optional Alternative Providers (Anthropic Claude, Google Gemini)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Anomaly Detection Settings
ANOMALY_THRESHOLD=0.75
SLIDING_WINDOW_SEC=60
MAX_INCIDENT_CANDIDATES=10
