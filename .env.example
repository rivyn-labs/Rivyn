# AI-Powered Observability - Environment Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# Optional: LLM Providers for enhanced generative reasoning
# If not provided, the platform uses its built-in deterministic, evidence-grounded inference engine.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
OPENAI_API_KEY=
GEMINI_API_KEY=

# Anomaly Detection Settings
ANOMALY_THRESHOLD=0.75
SLIDING_WINDOW_SEC=60
MAX_INCIDENT_CANDIDATES=10
